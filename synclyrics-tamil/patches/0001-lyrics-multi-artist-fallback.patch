+    @staticmethod
+    def _titles_match(query: str, found: str) -> bool:
+        """Loose title comparison: ignores (film name)/[..] suffixes, case and punctuation."""
+        import re as _re
+        def words(t):
+            t = _re.sub(r"[\(\[][^\)\]]*[\)\]]", " ", t or "")
+            t = _re.sub(r"\s+-\s+.*$", "", t)
+            return [w for w in _re.findall(r"[0-9a-z]+", t.lower()) if w]
+        q, f = words(query), words(found)
+        if not q or not f:
+            return True  # nothing to compare (e.g. non-Latin titles) - don't block
+        qs, fs = "".join(q), "".join(f)
+        if qs in fs or fs in qs:
+            return True
+        overlap = len(set(q) & set(f)) / max(1, min(len(set(q)), len(set(f))))
+        return overlap >= 0.5
