+    def _pick_best(self, results: list, artist: str, title: str, duration: Optional[int],
+                   require_match: bool) -> Optional[dict]:
+        """
+        Choose the best usable result (synced lyrics or instrumental).
+
+        A result's title must match the playing title (ignoring "(film name)" style
+        suffixes). With require_match=True (loose fallback searches) it must also either
+        be within 6s of the playing track's duration or share one of its artists, so a
+        title-only search cannot return a different song with the same name.
+        """
+        want_title = _norm(_clean_title(title))
+        want_artists = {_norm(a) for a in _split_artists(artist)} - {""}
+        best, best_score = None, None
+        for r in results or []:
+            if not (r.get("syncedLyrics") or r.get("instrumental")):
+                continue
+            r_title = _norm(_clean_title(r.get("trackName", "")))
+            r_artists = {_norm(a) for a in _split_artists(r.get("artistName", ""))} - {""}
+            title_ok = bool(want_title) and (r_title == want_title or
+                                             r_title.startswith(want_title) or
+                                             want_title.startswith(r_title))
+            artist_ok = bool(want_artists & r_artists) or any(
+                wa and ra and (wa in ra or ra in wa) for wa in want_artists for ra in r_artists)
+            dur_diff = None
+            if duration and r.get("duration"):
+                dur_diff = abs(float(r["duration"]) - float(duration))
+            dur_ok = dur_diff is not None and dur_diff <= 6
+            if not title_ok:
+                continue  # never show lyrics of a differently named song
+            if require_match and not (dur_ok or artist_ok):
+                continue
+            if duration and dur_diff is not None and dur_diff > 20 and not artist_ok:
+                continue  # almost certainly a different recording
+            score = (0 if title_ok else 1, 0 if artist_ok else 1,
+                     dur_diff if dur_diff is not None else 999)
+            if best_score is None or score < best_score:
+                best, best_score = r, score
+        return best
+
+    def _fallback_search(self, artist: str, title: str, duration: Optional[int]) -> Optional[dict]:
+        """Retry with each individual artist and a cleaned title, then title only."""
+        clean = _clean_title(title)
+        artists = _split_artists(artist)
+        attempts = []
+        if len(artists) > 1 or clean != title:
+            for a in artists:
+                attempts.append(("artist+title", {"track_name": clean, "artist_name": a}))
+        attempts.append(("title only", {"q": clean}))
+        if clean != title:
+            attempts.append(("full title", {"q": title}))
+
+        tried = set()
+        for label, params in attempts:
+            key = tuple(sorted(params.items()))
+            if key in tried:
+                continue
+            tried.add(key)
+            logger.info(f"LRCLib - Fallback search ({label}): {params}")
+            resp = self._make_request(f"{self.BASE_URL}/search", params)
+            if not resp or resp.status_code != 200:
+                continue
+            try:
+                results = resp.json()
+            except ValueError:
+                continue
+            match = self._pick_best(results, artist, title, duration, require_match=True)
+            if match:
+                logger.info(f"LRCLib - Fallback matched: {match.get('trackName')} by "
+                            f"{match.get('artistName')} (duration {match.get('duration')})")
+                return match
+        return None
