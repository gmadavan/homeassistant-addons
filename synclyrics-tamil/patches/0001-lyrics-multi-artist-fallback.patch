+# --- Multi-artist / decorated-title fallback helpers ---------------------------
+# Indian film music (and many compilations) tag several singers in one artist
+# field, e.g. "K.S. Chithra, Ilaiyaraaja & Arunmozhi", and often append the film
+# name to the title, e.g. "Adada Mamara (Chittukuruvi)". LRCLib usually stores
+# such songs under ONE artist and the bare title, so exact/field searches miss.
+
+_ARTIST_SPLIT_RE = re.compile(
+    r"\s*(?:,|;|/|&|\+|\bx\b|\band\b|\bfeat\.?|\bft\.?|\bfeaturing\b|\bwith\b)\s*",
+    re.IGNORECASE,
+)
+_TITLE_DECOR_RE = re.compile(r"\s*[\(\[][^\)\]]*[\)\]]\s*")
+_TITLE_DASH_RE = re.compile(r"\s+-\s+.*$")
+
+
+def _split_artists(artist: str) -> List[str]:
+    parts = [a.strip() for a in _ARTIST_SPLIT_RE.split(artist or "") if a and a.strip()]
+    seen, out = set(), []
+    for a in parts:
+        k = a.lower()
+        if k not in seen:
+            seen.add(k)
+            out.append(a)
+    return out
+
+
+def _clean_title(title: str) -> str:
+    t = _TITLE_DECOR_RE.sub(" ", title or "")
+    t = _TITLE_DASH_RE.sub("", t)
+    return re.sub(r"\s+", " ", t).strip() or (title or "").strip()
+
+
+def _norm(s: str) -> str:
+    return re.sub(r"[^0-9a-z]+", "", (s or "").lower())
+
