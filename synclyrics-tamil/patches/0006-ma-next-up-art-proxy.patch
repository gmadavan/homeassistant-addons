+def proxied_image_url(url: str) -> str:
+    """Route a Music Assistant image URL through SyncLyrics' /api/ma-image."""
+    import urllib.parse
+    # music-assistant-client builds weserv thumbnails as "&w=$256" (stray "$")
+    url = url.replace("&w=$", "&w=").replace("&h=$", "&h=")
+    return "/api/ma-image?u=" + urllib.parse.quote(url, safe="")
+
+
+def is_allowed_image_url(url: str) -> bool:
+    """Only fetch images from the MA server itself or MA's thumbnail service."""
+    bases = [_get_config_value("system.music_assistant.server_url", "") or ""]
+    try:
+        if _client and _client.server_info:
+            bases.append(_client.server_info.base_url or "")
+    except Exception:
+        pass
+    bases = [b.rstrip("/") + "/" for b in bases if b]
+    bases.append("https://images.weserv.nl/")
+    return any(url.startswith(b) for b in bases)
+
