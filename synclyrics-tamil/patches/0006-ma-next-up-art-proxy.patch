+@app.route("/api/ma-image")
+async def get_ma_image():
+    """Proxy a Music Assistant image (e.g. the next-up card) so the browser
+    loads it from this server instead of the MA address directly."""
+    from quart import Response
+    import aiohttp
+    from system_utils.sources import music_assistant as ma_source
+
+    url = request.args.get("u", "")
+    if not url or not ma_source.is_allowed_image_url(url):
+        return Response(status=404)
+    try:
+        timeout = aiohttp.ClientTimeout(total=10)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.get(url) as resp:
+                ctype = resp.headers.get("Content-Type", "")
+                if resp.status != 200 or not ctype.startswith("image/"):
+                    return Response(status=404)
+                data = await resp.read()
+    except Exception as e:
+        logger.debug(f"MA image proxy failed for {url}: {e}")
+        return Response(status=404)
+    return Response(data, content_type=ctype,
+                    headers={"Cache-Control": "public, max-age=86400"})
+
+
